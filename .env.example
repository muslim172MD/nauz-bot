# Обязательные секреты. Реальные значения храните только в защищённой среде.
TELEGRAM_TOKEN=
ANTHROPIC_API_KEY=

# Модель можно переопределить без изменения кода.
ANTHROPIC_MODEL=claude-opus-4-5

# По умолчанию диалоги не сохраняются на диск.
SAVE_DIALOGS=false
DIALOGS_DIR=data/dialogs

LOG_LEVEL=INFO
